# Server Port (Render sets this automatically)
PORT=3777
NODE_ENV=production

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.7-flash

# Frontend Origin for CORS (e.g., https://your-app.vercel.app or leave empty for all)
CORS_ORIGIN=*

# Option 1: Full MySQL Cloud Connection String (e.g., TiDB Cloud, Aiven, Railway)
# DATABASE_URL=mysql://user:password@host:3306/gpt_clone?ssl={"rejectUnauthorized":false}

# Option 2: Individual MySQL Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=gpt_clone
# Set to true when connecting to remote cloud databases like TiDB, Aiven, or Railway
DB_SSL=false
